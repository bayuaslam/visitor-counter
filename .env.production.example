# Copy to .env on the production server. Never commit the real .env.

LABHUB_DOMAIN=labrobotika.example.ac.id
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

LABHUB_SESSION_SECRET=replace-with-at-least-32-random-characters
# Keep this value single-quoted: PBKDF2 hashes contain '$' delimiters.
LABHUB_ADMIN_PASSWORD_HASH='pbkdf2_sha256$310000$REPLACE_SALT$REPLACE_DIGEST'

LABHUB_EDGE_DEVICE_ID=lab-robotika-01
LABHUB_EDGE_DEVICE_TOKEN=replace-with-a-long-random-device-token

LABHUB_SMTP_HOST=smtp.example.ac.id
LABHUB_SMTP_PORT=587
LABHUB_SMTP_USERNAME=replace-with-smtp-username
LABHUB_SMTP_PASSWORD=replace-with-smtp-password
LABHUB_SMTP_FROM=labrobotika@example.ac.id
LABHUB_SMTP_SSL=0
LABHUB_SMTP_STARTTLS=1
