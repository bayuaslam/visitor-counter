# SmartLab / LabHub local configuration
# Copy this file to .env and replace every placeholder locally.
# Never commit the real .env file.

# Admin authentication
LABHUB_ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$REPLACE_SALT$REPLACE_DIGEST
LABHUB_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Edge visitor-counter settings (PC lab only)
LABHUB_HEADLESS=1
LABHUB_CAMERA_IP=192.168.137.88
LABHUB_CAMERA_PASSWORD=replace-with-cctv-password
