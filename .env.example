# SmartLab / LabHub configuration
# Copy this file to .env for local use and replace every placeholder.
# Never commit the real .env file.

# Application mode
LABHUB_ENV=development
LABHUB_COOKIE_SECURE=0
LABHUB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LABHUB_ALLOW_UNVERIFIED_REGISTRATION=1

# Server database and uploads
# Local fallback example:
DATABASE_URL=sqlite:///labhub.db
LABHUB_UPLOAD_DIR=storage/uploads
# Production example format:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Admin authentication
LABHUB_ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$REPLACE_SALT$REPLACE_DIGEST
LABHUB_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Edge device authentication -- use the same ID/token on server and PC lab
LABHUB_EDGE_DEVICE_ID=lab-robotika-01
LABHUB_EDGE_DEVICE_TOKEN=replace-with-a-random-device-token-at-least-24-characters

# PC lab -> online server
LABHUB_SERVER_URL=https://replace-with-production-domain.example
LABHUB_EDGE_SYNC_INTERVAL=2
LABHUB_EDGE_HEARTBEAT_INTERVAL=5
LABHUB_EDGE_COMMAND_INTERVAL=5

# Visitor counter / CCTV settings (PC lab only)
LABHUB_HEADLESS=1
LABHUB_CAMERA_IP=192.168.137.88
LABHUB_CAMERA_PASSWORD=replace-with-cctv-password
